# ─────────────────────────────────────────────────────────────
# BuyWise — environment configuration
# Copy to apps/api/.env (backend) and apps/web/.env (frontend).
# Never commit real secrets. Keys are used server-side only.
# ─────────────────────────────────────────────────────────────

# ── OpenAI (server-side only — NEVER expose to the frontend) ──
OPENAI_API_KEY=sk-your-key-here
# A current reasoning-capable chat model exposed via the API.
OPENAI_MODEL=gpt-4.1-mini

# ── Database (optional for demo mode; required for persistence) ──
# Neon / Supabase connection string. If omitted, the API runs in
# in-memory DEMO mode (research + scoring work, nothing persists).
DATABASE_URL=postgresql://user:password@host:5432/buywise?sslmode=require

# ── Redis (optional — used for caching + rate-limit store) ──
# If omitted, an in-memory cache + limiter is used.
REDIS_URL=redis://localhost:6379

# ── Auth / sessions ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Long random string. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# ── URLs / networking ──
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:4000
PORT=4000
NODE_ENV=development

# ── Frontend (apps/web/.env) — only VITE_ vars reach the browser ──
VITE_API_URL=http://localhost:4000
VITE_ENABLE_3D=true
